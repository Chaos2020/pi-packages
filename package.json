{
  "private": true,
  "name": "@gotgenes/pi-packages",
  "type": "module",
  "description": "Monorepo for @gotgenes pi packages",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "command -v prek >/dev/null 2>&1 && prek install || echo 'prek not found — skipping hook install (see README)'",
    "check": "pnpm -r run check",
    "test": "pnpm -r run test",
    "lint": "biome check . && eslint packages/ && rumdl check .",
    "lint:fix": "biome check --write . && eslint packages/ --fix && rumdl fmt .",
    "format": "biome format --write .",
    "fallow": "fallow",
    "fallow:audit": "fallow audit",
    "fallow:health": "fallow health --score --hotspots --targets",
    "fallow:dead-code": "fallow dead-code",
    "fallow:dupes": "fallow dupes"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "eslint": "catalog:",
    "fallow": "catalog:",
    "globals": "catalog:",
    "rumdl": "^0.2.10",
    "typescript-eslint": "catalog:"
  },
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@biomejs/biome": "^2.4.16",
      "eslint": "^10.4.1",
      "globals": "^17.5.0",
      "typescript-eslint": "^8.61.0",
      "rumdl": "^0.2.10",
      "typescript": "^6.0.3",
      "vitest": "^4.1.8",
      "@types/node": "^22.15.3",
      "fallow": "^3.2.0",
      "rollup": "^4.62.2",
      "rollup-plugin-dts": "^6.4.1"
    }
  }
}
